---
import { getCollection } from 'astro:content'
import Article from '../layouts/Article.astro'

const entries = (await getCollection('articles')).sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())
const base = import.meta.env.BASE_URL
---
<Article title="PulseMesh" summary="经过筛选和核验的行业资讯" language="zh-CN">
  <section class="hero">
    <p class="eyebrow">CURATED SIGNALS</p>
    <h1>值得阅读的行业动态</h1>
    <p>只展示经过去重、筛选、证据校验和语言生成的内容。</p>
  </section>
  <section class="article-grid">
    {entries.map((entry) => (
      <article class="card">
        <p class="meta">{entry.data.language} · {entry.data.publishedAt.toLocaleDateString()}</p>
        <h2><a href={`${base}${entry.id}/`}>{entry.data.title}</a></h2>
        <p>{entry.data.summary}</p>
        <a class="read-more" href={`${base}${entry.id}/`}>阅读全文 →</a>
      </article>
    ))}
  </section>
</Article>
