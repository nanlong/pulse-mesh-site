---
interface Props {
  title: string
  summary: string
  language: string
  translations?: Array<{ language: string; href: string }>
}

import '../styles/global.css'

const { title, summary, language, translations = [] } = Astro.props
const base = import.meta.env.BASE_URL
---
<!doctype html>
<html lang={language}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={summary} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={summary} />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href={base}>PulseMesh</a>
      <nav aria-label="Language">
        <a href={base}>首页</a>
        {translations.length > 1 && translations.map((translation) => <a href={translation.href} aria-current={translation.language === language ? 'page' : undefined}>{translation.language}</a>)}
      </nav>
    </header>
    <main><slot /></main>
    <footer>Generated by PulseMesh</footer>
  </body>
</html>
